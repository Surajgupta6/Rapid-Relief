# .env.test
# Environment variables for the test suite.
# Copy this to .env.test.local and fill in a real MongoDB URI to run integration tests.
#
# Option A: Local MongoDB (default)
#   Start MongoDB: mongod --dbpath /tmp/testdb
#   Then: MONGO_TEST_URI=mongodb://localhost:27017/rapid-relief-test npm test
#
# Option B: MongoDB Atlas (CI/CD)
#   MONGO_TEST_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rapid-relief-test
#
# Option C: MongoMemoryServer (auto, requires internet on first run to download binary)
#   Leave MONGO_TEST_URI unset — the test suite will use MongoMemoryServer automatically.

NODE_ENV=test
MONGO_TEST_URI=mongodb://localhost:27017/rapid-relief-test
SESSION_SECRET=test-session-secret-at-least-32-chars-long
JWT_SECRET=test-jwt-secret
PORT=0
