# .env.example
# Copy this file to .env and fill in the values for your local environment.
# Never commit your actual .env file.

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string.
# For local development: mongodb://localhost:27017/rapid-relief
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rapid-relief
MONGODB_URI=mongodb://localhost:27017/rapid-relief

# Session secret -- use a long, random string (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# JWT secret -- installed but not yet actively used in routes.
# Required to be present; set to any non-empty string until JWT auth is implemented.
JWT_SECRET=replace_with_a_long_random_string
